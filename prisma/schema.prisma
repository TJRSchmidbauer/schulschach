generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TRAINER
}

enum AttemptResult {
  SOLVED_INDEPENDENT
  SOLVED_WITH_HINT
  SOLUTION_VIEWED
  ABANDONED
}

enum AttemptSource {
  MODULE
  ASSIGNMENT
  SELF
}

enum GameStatus {
  WAITING
  ACTIVE
  FINISHED
}

model User {
  id                String             @id @default(cuid())
  alias             String             @unique
  role              Role               @default(STUDENT)
  codeLookup        String             @unique
  codeHash          String
  codeEnc           String?
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  lastLoginAt       DateTime?
  sessions          Session[]
  attempts          Attempt[]
  assignmentTargets AssignmentTarget[]
  gamesWhite        Game[]             @relation("GameWhite")
  gamesBlack        Game[]             @relation("GameBlack")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  role      Role
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LearningPath {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  modules     Module[]
}

model Module {
  id             String         @id @default(cuid())
  learningPathId String
  learningPath   LearningPath   @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  title          String
  contentMd      String
  sortOrder      Int            @default(0)
  active         Boolean        @default(true)
  modulePuzzles  ModulePuzzle[]
}

model Puzzle {
  id                String             @id
  origin            String             @default("own")
  fen               String
  solutionUci       String
  rating            Int
  themes            String[]
  title             String
  hint              String
  explanation       String
  published         Boolean            @default(true)
  modulePuzzles     ModulePuzzle[]
  assignmentPuzzles AssignmentPuzzle[]
  attempts          Attempt[]

  @@index([rating])
}

model ModulePuzzle {
  moduleId  String
  puzzleId  String
  sortOrder Int
  module    Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  puzzle    Puzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  @@id([moduleId, puzzleId])
}

model Assignment {
  id        String             @id @default(cuid())
  title     String
  dueAt     DateTime?
  targetAll Boolean            @default(false)
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  puzzles   AssignmentPuzzle[]
  targets   AssignmentTarget[]
  attempts  Attempt[]
}

model AssignmentPuzzle {
  assignmentId String
  puzzleId     String
  sortOrder    Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  puzzle       Puzzle     @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  @@id([assignmentId, puzzleId])
}

model AssignmentTarget {
  assignmentId String
  userId       String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([assignmentId, userId])
}

model Attempt {
  id              String        @id @default(cuid())
  userId          String
  puzzleId        String
  assignmentId    String?
  source          AttemptSource @default(MODULE)
  result          AttemptResult
  hintsUsed       Int           @default(0)
  wrongAttempts   Int           @default(0)
  durationSeconds Int           @default(0)
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzle          Puzzle        @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  assignment      Assignment?   @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([assignmentId])
}

model Game {
  id               String     @id @default(cuid())
  status           GameStatus @default(WAITING)
  whiteId          String?
  blackId          String?
  createdByTrainer Boolean    @default(false)
  startFen         String
  fen              String
  moves            String     @default("")
  initialSeconds   Int
  incrementSeconds Int
  whiteMs          Int
  blackMs          Int
  lastMoveAt       DateTime?
  drawOffer        String?
  result           String?
  reason           String?
  createdAt        DateTime   @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?
  white            User?      @relation("GameWhite", fields: [whiteId], references: [id], onDelete: SetNull)
  black            User?      @relation("GameBlack", fields: [blackId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([finishedAt])
  @@index([whiteId])
  @@index([blackId])
}
